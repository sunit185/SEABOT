# ==============================================================================
# SEABOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Select your hardware profile below:
# ------------------------------------------------------------------------------
# PROFILE 1: LOW (8 GB RAM Laptop, e.g., Intel i5 / MacBook Air)
# OLLAMA_MODEL=gemma4:4b
# HARDWARE_PROFILE=LOW
#
# PROFILE 2: STANDARD (16 GB RAM Vessel Laptop / Server, CPU or light GPU) [DEFAULT]
# OLLAMA_MODEL=gemma4:12b
# HARDWARE_PROFILE=STANDARD
#
# PROFILE 3: HIGH (24 GB+ VRAM Workstation / GPU Rack, e.g., RTX 4090 / A5000)
# OLLAMA_MODEL=gemma4:27b
# HARDWARE_PROFILE=HIGH
# ------------------------------------------------------------------------------

# Active Profile & Ollama Model
HARDWARE_PROFILE=STANDARD
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://ollama:11434

# Embeddings (local via Ollama or sentence-transformers)
EMBED_MODEL=nomic-embed-text
RERANKER_ENABLED=false

# Retrieval Tuning
VECTOR_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=6
RELEVANCE_THRESHOLD=0.3

# Ingestion
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=200

# Security & Access Control
PIN_ENABLED=false
PIN_CODE=1234
LAN_BIND=false

# Storage & Logging Paths
DATA_DIR=/app/data
LOG_FILE=/app/data/logs/seabot.log
